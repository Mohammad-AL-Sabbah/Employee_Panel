{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PSRS-Admin",
  "version": "0.1.0",
  "identifier": "com.psrs.emergency.center",
"build": {
  "beforeDevCommand": "npm run dev",
  "beforeBuildCommand": "npm run build",
  "devUrl": "http://localhost:5173",
  "frontendDist": "../dist"
},
  "app": {
"windows": [
  {
    "title": "PSRS | Emergency Command Center",
    "width": 1280,
    "height": 800,
    "resizable": true,
    "url": "/?platform=tauri" 
  }
],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
"icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ]
  }
}
